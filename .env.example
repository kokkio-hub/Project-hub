# Copy this file to .env and adjust. Every setting is optional.

# Name shown in the sidebar, sign-in screen and browser tab.
APP_NAME=Project Hub

# Port the app listens on (ignored by docker-compose, which always uses 3000 inside the container).
PORT=3000

# SQLite database file (ignored by docker-compose, which stores it in the project-hub-data volume).
# DATABASE_PATH=./data/project-hub.db

# Set to 1 when the app runs behind a reverse proxy (Caddy, nginx, Traefik, a cloud load balancer),
# so it sees the real client IP and knows when the connection was HTTPS.
TRUST_PROXY=

# Secure (HTTPS-only) session cookies: auto = when the request came in over HTTPS; or true / false.
COOKIE_SECURE=auto

# How long people stay signed in without using the app, in days.
SESSION_TTL_DAYS=30

# Failed sign-in attempts allowed per IP address per 15 minutes.
LOGIN_RATE_LIMIT=20

# Optional: create the first admin automatically on first start (instead of the setup screen).
# Remove the password from this file after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---------------------------------------------------------------------------
# Email (optional): invitations and "Forgot your password?" links.
# Without SMTP_HOST, email is off: admins share invite links or temporary passwords instead.
# Check the settings with: npm run cli -- send-test-email --to you@yourcompany.com
# ---------------------------------------------------------------------------

# The address people open the app on, e.g. https://projects.yourcompany.com
# Links in emails point here. "Forgot your password?" only appears when this is set.
APP_URL=

# Your mail server or email service (SMTP).
SMTP_HOST=
# 587 is the usual port (STARTTLS). Port 465 uses TLS from the start.
SMTP_PORT=587
# true = TLS from the start, false = STARTTLS. Leave empty to decide by port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Who the emails come from. Must be an address your mail service lets you send from,
# e.g. MAIL_FROM="Project Hub <projects@yourcompany.com>". Defaults to SMTP_USER.
MAIL_FROM=

# Or send through Resend (https://resend.com), over HTTPS instead of SMTP. Use this where
# outgoing mail ports are blocked, such as Railway's Free and Hobby plans. Takes priority
# over SMTP_HOST. MAIL_FROM must then be an address on a domain you verified in Resend.
RESEND_API_KEY=

# How many days invitation links work.
INVITE_TTL_DAYS=7

# Only for docker-compose.caddy.yml (HTTPS): the domain name pointing at this server.
DOMAIN=
